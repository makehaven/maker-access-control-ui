[Unit]
Description=Maker Access Control box (local access authority)
Documentation=https://github.com/makehaven/maker-access-control-ui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maker
Group=maker
EnvironmentFile=/etc/maker-access-control/maker-access-control.env
WorkingDirectory=/opt/maker-access-control
Environment=PYTHONPATH=/opt/maker-access-control/src
ExecStart=/opt/maker-access-control/.venv/bin/hypercorn \
    --bind 0.0.0.0:8080 \
    maker_access_control_ui.ui.app:app

# The whole point of this box is to keep answering. Restart forever, and never
# let a restart storm trip systemd's rate limiter into giving up.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

# The store must survive a reboot: a box that comes back empty denies everyone.
StateDirectory=maker-access-control
ReadWritePaths=/var/lib/maker-access-control

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=maker-access-control

[Install]
WantedBy=multi-user.target
