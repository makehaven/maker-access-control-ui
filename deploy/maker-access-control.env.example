# Maker Access Control box — production environment.
#
# Copy to /etc/maker-access-control/maker-access-control.env on the Proxmox LXC
# and fill in the two secrets. Keep the file 0600 and owned by the service user:
# it holds the fallback download code.

# ---------------------------------------------------------------- provider
# Forces the JSON-backed provider. The box has no database of its own; the
# store file below is the whole authority.
CARDSYS_TEST_MODE=1
CARDSYS_TEST_STORE=/var/lib/maker-access-control/maker-store.json
READER_TO_TOOL_CONFIG_PATH=/etc/maker-access-control/reader-config.json

# ---------------------------------------------------------------- sync
# Where the membership snapshot comes from, and the shared code that unlocks
# it. Set the code at /admin/config/system/access-control-api-logger — never
# reuse the local simulation code.
MAKER_ACCESS_CONTROL_FALLBACK_URL=https://makehaven.org/api/v0/access-control/fallback-store
MAKER_ACCESS_CONTROL_FALLBACK_CODE=CHANGE_ME

MAKER_ACCESS_CONTROL_SYNC_ENABLED=1
# Seconds between polls. An unchanged poll costs one conditional request and no
# transfer, so a short interval is cheap; this bounds how long a revocation can
# take to reach the door.
MAKER_ACCESS_CONTROL_SYNC_INTERVAL=180
MAKER_ACCESS_CONTROL_SYNC_JITTER=15
# The export takes ~20s to build cold on Pantheon; do not set this below that.
MAKER_ACCESS_CONTROL_SYNC_TIMEOUT=60

# Floors that stop a half-broken export from revoking the membership. A Drupal
# query that half-fails still returns HTTP 200 with well-formed JSON.
MAKER_ACCESS_CONTROL_SYNC_MIN_USERS=100
MAKER_ACCESS_CONTROL_SYNC_MAX_SHRINK_RATIO=0.5

# ---------------------------------------------------------------- health
# /health answers 200 while ok/degraded and 503 once stale/empty/unknown.
# Point an uptime monitor at it: a box that has quietly stopped syncing keeps
# answering from a frozen store, which fails *open* for revoked members.
MAKER_ACCESS_CONTROL_HEALTH_WARN_SECONDS=600
MAKER_ACCESS_CONTROL_HEALTH_CRITICAL_SECONDS=1800

# ---------------------------------------------------------------- proxy
# Ask Drupal when the snapshot cannot answer honestly: an unknown member, an
# unknown permission, or a denial on a store too old to believe. A fresh local
# deny is trusted, and any upstream failure leaves the local answer standing.
MAKER_ACCESS_CONTROL_PROXY_ENABLED=1
# Defaults to the origin of the fallback URL; set explicitly only to differ.
# MAKER_ACCESS_CONTROL_PROXY_BASE_URL=https://makehaven.org
MAKER_ACCESS_CONTROL_PROXY_TIMEOUT=2.5
MAKER_ACCESS_CONTROL_PROXY_CACHE_SECONDS=30

# ---------------------------------------------------------------- log-forward
# Nine Drupal modules read access_control_log entities, and today every badge
# tap creates one *because Drupal answers the request*. Once this box answers
# instead, this is the only thing keeping those reports fed -- most visibly the
# lobby presence display, which otherwise goes blank for door entries.
#
# The ingest code is a WRITE credential and must differ from the download code
# above. That one is handed to a read-only consumer; reusing it here would let
# anyone holding it forge entries in the access log.
MAKER_ACCESS_CONTROL_LOG_FORWARD_ENABLED=1
MAKER_ACCESS_CONTROL_LOG_FORWARD_CODE=CHANGE_ME_TOO
# Defaults to <fallback origin>/api/v0/access-control/log.
# MAKER_ACCESS_CONTROL_LOG_FORWARD_URL=https://makehaven.org/api/v0/access-control/log

MAKER_ACCESS_CONTROL_LOG_FORWARD_INTERVAL=15
MAKER_ACCESS_CONTROL_LOG_FORWARD_BATCH_SIZE=200
MAKER_ACCESS_CONTROL_LOG_FORWARD_TIMEOUT=15
# The queue lives beside the store and survives a reboot, so an outage does not
# cost an evening of history. The cap stops a long outage from filling the disk
# and taking the door down with it; overflow is counted and logged, never
# dropped quietly.
MAKER_ACCESS_CONTROL_LOG_FORWARD_MAX_QUEUE=50000
